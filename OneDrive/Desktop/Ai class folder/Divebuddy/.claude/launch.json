{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "divebuddy-frontend",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "frontend"],
      "port": 5500
    },
    {
      "name": "divebuddy-backend",
      "runtimeExecutable": "..\\.venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "autoPort": false,
      "cwd": "backend"
    }
  ]
}
